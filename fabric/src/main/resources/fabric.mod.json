{
  "schemaVersion": 1,
  "id": "cloud_tweaks",
  "version": "${version}",
  "name": "Cloud Tweaks",
  "description": "Customize your clouds!",
  "authors": [],
  "license": "MIT",
  "icon": "assets/cloud_tweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.not_thefirst.story_mode_clouds.StoryModeClouds"
    ],
    "modmenu": [
      "net.not_thefirst.story_mode_clouds.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "cloud_tweaks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${version_range}"
  },
  "recommends": {
    "yet_another_config_lib_v3": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.issues": "https://github.com/projectAccounth/better_clouds/issues"
      }
    }
  }
}